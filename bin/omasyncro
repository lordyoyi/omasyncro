#!/bin/bash
#
# omasyncro: keep every Omarchy machine on your tailnet with the same themes,
# wallpapers and active theme.
#
#   omasyncro setup [<data-repo-url>]   set up this machine (install.sh runs it)
#   omasyncro status                    library, active theme and peers
#   omasyncro sync [--update]           sync the library now (--update: git pull every theme)
#   omasyncro remove <theme>            uninstall a theme on every machine
#   omasyncro remove-bg <theme>/<file>  delete a wallpaper on every machine
#
# Internal, run by systemd: tick, changed, serve.

set -uo pipefail

LIB="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib" && pwd)"
source "$LIB/common.sh"
source "$LIB/library.sh"
source "$LIB/active.sh"
source "$LIB/peers.sh"

UNITS=(omasyncro.socket omasyncro@.service omasyncro-active.path omasyncro-active.service omasyncro.timer omasyncro.service)
DATA_REPO_NAME=omasyncro-data

# gh's answer, last line only: version managers like mise can print notices
# on stdout before it.
gh_value() { gh "$@" 2>/dev/null | tail -n1; }

# Without a URL: reuse <you>/omasyncro-data on GitHub, creating it if needed.
github_data_repo() {
  local url
  command -v gh >/dev/null && gh auth status &>/dev/null || return 1
  url=$(gh_value repo view "$DATA_REPO_NAME" --json url -q .url)
  if [[ $url != https://* ]]; then
    gh repo create "$DATA_REPO_NAME" --private \
      --description "Omarchy themes and wallpapers, synced by omasyncro" >/dev/null 2>&1 || return 1
    url=$(gh_value repo view "$DATA_REPO_NAME" --json url -q .url)
  fi
  [[ $url == https://* ]] && echo "$url"
}

clone_data() {
  mkdir -p "$(dirname "$DATA")"
  git clone -q -- "$1" "$DATA" 2> >(grep -v 'empty repository' >&2) || die "could not clone $1"
  git_data rev-parse -q --verify HEAD >/dev/null && return 0
  # A brand-new data repo: lay it out.
  mkdir -p "$DATA/backgrounds"
  touch "$DATA/themes.txt" "$DATA/removed.txt" "$DATA/backgrounds/.keep"
  printf 'themes.txt merge=union\nremoved.txt merge=union\n' >"$DATA/.gitattributes"
  printf '# Omarchy library\n\nData for [omasyncro](https://github.com/lordyoyi/omasyncro). Edited by the tool; no need to touch it by hand.\n' >"$DATA/README.md"
  git_data checkout -q -b main 2>/dev/null
  set_identity
  git_data add -A && git_data commit -q -m "Start the library" && git_data push -q -u origin main ||
    die "could not push to $1"
}

# Commits need an author. Use the global git identity, else the GitHub
# account, else something recognisable.
set_identity() {
  git_data config user.email >/dev/null && return 0
  local login id
  if command -v gh >/dev/null && login=$(gh_value api user -q .login) && [[ -n $login ]]; then
    id=$(gh_value api user -q .id)
    git_data config user.name "$(gh_value api user -q '.name // .login')"
    git_data config user.email "$id+$login@users.noreply.github.com"
  else
    git_data config user.name "omasyncro"
    git_data config user.email "omasyncro@$NAME"
  fi
}

link_units() {
  local unit units_dir="$HOME/.config/systemd/user"
  mkdir -p "$units_dir/omasyncro.socket.d"
  for unit in "${UNITS[@]}"; do
    ln -sf "$OMASYNCRO_HOME/systemd/$unit" "$units_dir/$unit"
  done
  # Listen on this machine's Tailscale address only, never on the LAN.
  printf '[Socket]\nListenStream=\nListenStream=%s:%s\n' "$1" "$PORT" >"$units_dir/omasyncro.socket.d/address.conf"
  systemctl --user daemon-reload
}

cmd_setup() {
  local url=${1:-} ip existing
  command -v tailscale >/dev/null || die "Tailscale is required: https://tailscale.com/download/linux"
  ip=$(tailscale ip -4 2>/dev/null | head -n1)
  [[ -n $ip ]] || die "Tailscale is not up on this machine (tailscale up)"

  if configured; then
    existing=$(git_data remote get-url origin)
    [[ -z $url || $(norm_url "$url") == "$(norm_url "$existing")" ]] ||
      die "already using $existing; run uninstall.sh --purge first to switch"
  else
    [[ -n $url ]] || url=$(github_data_repo) ||
      die "pass the git URL of a (private) repo for your library: omasyncro setup <url>"
    echo "Library: $url"
    clone_data "$url"
  fi
  set_identity

  echo "Adding this machine's themes and wallpapers to the library..."
  library_sync
  link_units "$ip"
  systemctl --user enable --now omasyncro.socket omasyncro-active.path omasyncro.timer
  (( PUSHED )) && broadcast PULL
  active_hello
  echo
  cmd_status
}

self_update() {
  local before
  [[ $AUTO_UPDATE == yes && -d $OMASYNCRO_HOME/.git ]] || return 0
  before=$(git -C "$OMASYNCRO_HOME" rev-parse HEAD)
  git -C "$OMASYNCRO_HOME" pull -q --ff-only 2>>"$LOG" || return 0
  if ! git -C "$OMASYNCRO_HOME" diff --quiet "$before" HEAD -- systemd; then
    link_units "$(tailscale ip -4 | head -n1)"
    systemctl --user restart omasyncro.socket
  fi
}

# Every 5 minutes: catch up on the active theme, push new local themes or
# wallpapers, and do a full library sync every LIBRARY_INTERVAL_MIN.
cmd_tick() {
  if library_due; then
    self_update
    library_sync
  elif library_dirty; then
    library_sync
  fi
  (( ${PUSHED:-0} )) && broadcast PULL
  active_hello
}

# short <text>: at most 32 characters, for the status table.
short() { (( ${#1} > 32 )) && echo "${1:0:29}..." || echo "$1"; }

cmd_status() {
  local url name missing=() count=0 ip host reply ts origin theme bg mark
  configured || die "not set up yet: run install.sh"
  read_active
  while read -r url; do
    [[ -n $url ]] || continue
    count=$((count + 1))
    name=$(theme_name "$url")
    [[ -d $THEMES_DIR/$name ]] || missing+=("$name")
  done <"$LIST"

  printf '%-12s%s\n' Library "$(git_data remote get-url origin)"
  printf '%-12s%s\n' Themes "$count from git, ${missing[*]:+missing here: }${missing[*]:-all installed}"
  printf '%-12s%s\n' Wallpapers "$(find "$DATA/backgrounds" -type f ! -name .keep | wc -l) extra"
  printf '%-12s%s\n' Active "$A_THEME, ${A_BG##*/}"
  echo
  echo Machines
  printf '  %-12s%-20s%-34s%s\n' "$NAME" "$A_THEME" "$(short "${A_BG##*/}")" "this one"
  # Ask every peer at once; a machine that drops the connection costs 3 s, not 3 s each.
  local tmp
  tmp=$(mktemp -d)
  while read -r ip host; do
    send "$ip" GET >"$tmp/$host" &
  done < <(peers)
  wait
  for reply in "$tmp"/*; do
    [[ -s $reply ]] || continue
    host=${reply##*/}
    IFS=$'\t' read -r ts origin theme bg <"$reply"
    [[ $ts == "$A_TS" ]] && mark="in sync" || mark="out of sync"
    printf '  %-12s%-20s%-34s%s\n' "$host" "$theme" "$(short "${bg##*/}")" "$mark"
  done
  rm -rf "$tmp"
}

cmd_sync() {
  configured || die "not set up yet: run install.sh"
  library_sync
  [[ ${1:-} == --update ]] && update_themes
  (( PUSHED )) && broadcast PULL
  echo "Library synced."
}

case ${1:-} in
  setup) cmd_setup "${2:-}" ;;
  status) cmd_status ;;
  sync) cmd_sync "${2:-}" ;;
  remove) library_remove "${2:?usage: omasyncro remove <theme>}" && (( PUSHED )) && broadcast PULL ;;
  remove-bg) library_remove_bg "${2:?usage: omasyncro remove-bg <theme>/<file>}" && (( PUSHED )) && broadcast PULL ;;
  tick) configured && cmd_tick ;;
  changed) configured && active_changed ;;
  serve) serve ;;
  -h | --help | "") sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $1 (see omasyncro --help)" ;;
esac
